direction: down

classes: {
  primary: {
    style: {
      fill: "#070707"
      stroke: "#f4f4f5"
      font-color: "#f4f4f5"
      border-radius: 18
      stroke-width: 2
    }
  }
  secondary: {
    style: {
      fill: "#0a0a0a"
      stroke: "#a1a1aa"
      font-color: "#d4d4d8"
      border-radius: 18
      stroke-width: 2
    }
  }
  shell: {
    style: {
      fill: "transparent"
      stroke: "#f4f4f5"
      font-color: "#f4f4f5"
      border-radius: 28
      stroke-width: 2
    }
  }
}

exchange_sources: Exchange Sources {
  style: {
    fill: "transparent"
    stroke: "#f4f4f5"
    font-color: "#f4f4f5"
    border-radius: 28
    stroke-width: 2
  }

  binance: "Binance\n(Snapshots + Deltas\nCRC32 Checksum)" {
    class: primary
  }

  coinbase: "Coinbase\n(Deltas Only\nCustom Hash)" {
    class: primary
  }

  other_exchanges: "Other Exchanges\n(Various Patterns)" {
    class: primary
  }
}

network_layer: Network Layer {
  style: {
    fill: "transparent"
    stroke: "#f4f4f5"
    font-color: "#f4f4f5"
    border-radius: 24
    stroke-width: 2
  }

  websocket: "WebSocket Connections" {
    class: secondary
  }
}

core_processing_engine: Core Processing Engine {
  style: {
    fill: "transparent"
    stroke: "#f4f4f5"
    font-color: "#f4f4f5"
    border-radius: 32
    stroke-width: 2
  }

  sequence_handler: "Sequence Handler" {
    class: shell
  }

  state_management: State Management {
    style: {
      fill: "transparent"
      stroke: "#f4f4f5"
      font-color: "#f4f4f5"
      border-radius: 24
      stroke-width: 2
    }

    checksum_validation: "Checksum Validation\n(CRC32 / Custom)" {
      class: primary
    }

    state_drift_detection: "State Drift Detection" {
      class: secondary
    }

    auto_resync: "Auto Re-sync Trigger" {
      class: primary
    }
  }

  processing_pipeline: {
    style: {
      fill: "transparent"
      stroke: "#f4f4f5"
      font-color: "#f4f4f5"
      border-radius: 24
      stroke-width: 2
    }

    snapshot_handler: "Snapshot Handler\n(Full State)" {
      class: primary
    }

    delta_handler: "Delta Handler\n(Incremental Update)" {
      class: secondary
    }

    message_reordering: "Message Reordering" {
      class: primary
    }
  }

  memory_management: Memory Management {
    style: {
      fill: "transparent"
      stroke: "#f4f4f5"
      font-color: "#f4f4f5"
      border-radius: 24
      stroke-width: 2
    }

    order_book_store: "Order Book Store\n(10k+ Levels)" {
      class: primary
    }

    smart_pruning: "Smart Pruning\n(Depth Limits)" {
      class: secondary
    }

    binary_search: "Binary Search\nO(log n) insertion" {
      class: secondary
    }
  }

  storage_layer: Storage Layer {
    style: {
      fill: "transparent"
      stroke: "#f4f4f5"
      font-color: "#f4f4f5"
      border-radius: 24
      stroke-width: 2
    }

    redis: "Redis\n(Compressed Snapshots\nLRU Eviction)" {
      class: primary
    }
  }
}

exchange_sources.binance -> network_layer.websocket
exchange_sources.coinbase -> network_layer.websocket
exchange_sources.other_exchanges -> network_layer.websocket

network_layer.websocket -> core_processing_engine.sequence_handler
core_processing_engine.sequence_handler -> core_processing_engine.processing_pipeline.snapshot_handler
core_processing_engine.sequence_handler -> core_processing_engine.processing_pipeline.delta_handler
core_processing_engine.sequence_handler -> core_processing_engine.processing_pipeline.message_reordering
core_processing_engine.sequence_handler -> core_processing_engine.state_management.checksum_validation

core_processing_engine.state_management.checksum_validation -> core_processing_engine.state_management.state_drift_detection
core_processing_engine.state_management.state_drift_detection -> core_processing_engine.state_management.auto_resync: Mismatch
core_processing_engine.state_management.auto_resync -> core_processing_engine.processing_pipeline.snapshot_handler: Trigger

core_processing_engine.processing_pipeline.snapshot_handler -> core_processing_engine.memory_management.order_book_store
core_processing_engine.processing_pipeline.delta_handler -> core_processing_engine.memory_management.order_book_store
core_processing_engine.processing_pipeline.message_reordering -> core_processing_engine.memory_management.order_book_store

core_processing_engine.memory_management.order_book_store -> core_processing_engine.memory_management.smart_pruning
core_processing_engine.memory_management.order_book_store -> core_processing_engine.memory_management.binary_search
core_processing_engine.memory_management.order_book_store -> core_processing_engine.storage_layer.redis
